pkgname=noctalia-custom
pkgver=@PKGVER@
pkgrel=2
pkgdesc='Noctalia desktop shell with locally maintained custom features'
arch=('x86_64')
url='https://github.com/T4T3Z0R/noctalia'
license=('MIT AND Apache-2.0')

depends=(
  'bash'
  'cairo'
  'curl'
  'fontconfig'
  'freetype2'
  'git'
  'glib2'
  'glibc'
  'harfbuzz'
  'hicolor-icon-theme'
  'jemalloc'
  'libgcc'
  'libglvnd'
  'libical'
  'libjxl'
  'libpipewire'
  'libqalculate'
  'librsvg'
  'libsecret'
  'libsndfile'
  'libsodium'
  'libstdc++'
  'libwebp'
  'libwireplumber'
  'libxkbcommon'
  'libxml2'
  'md4c'
  'pam'
  'pango'
  'polkit'
  'sdbus-cpp'
  'tomlplusplus'
  'wayland'
)

makedepends=(
  'meson'
  'ninja'
  'nlohmann-json'
  'pkgconf'
  'stb'
  'wayland-protocols'
)

provides=('noctalia')
conflicts=('noctalia' 'noctalia-bin' 'noctalia-git' 'noctalia-penfix')
replaces=('noctalia-penfix')

options=('!debug')

source=('noctalia-src.tar.gz')
sha256sums=('@SOURCE_SHA256@')

build() {
  cd "$srcdir/noctalia-src"

  meson setup build-package \
    --prefix=/usr \
    --buildtype=release \
    -Dcpp_std=c++23 \
    -Dtests=disabled \
    -Dnative_optimizations=false

  meson compile -C build-package noctalia
}

package() {
  cd "$srcdir/noctalia-src"

  meson install \
    -C build-package \
    --destdir "$pkgdir"

  local licensedir="$pkgdir/usr/share/licenses/$pkgname"
  local docdir="$pkgdir/usr/share/doc/$pkgname"

  # Noctalia's own MIT notice.
  install -Dm644 LICENSE \
    "$licensedir/LICENSE"

  # Vendored libraries compiled into the Noctalia binary.
  install -Dm644 third_party/fzy/LICENSE \
    "$licensedir/fzy-LICENSE"
  install -Dm644 third_party/luau/LICENSE.txt \
    "$licensedir/Luau-LICENSE"
  install -Dm644 third_party/luau/lua_LICENSE.txt \
    "$licensedir/Lua-LICENSE"
  install -Dm644 third_party/material_color_utilities/LICENSE \
    "$licensedir/Material-Color-Utilities-LICENSE"
  install -Dm644 third_party/wuffs/LICENSE-APACHE \
    "$licensedir/Wuffs-LICENSE-APACHE"
  install -Dm644 third_party/wuffs/LICENSE-MIT \
    "$licensedir/Wuffs-LICENSE-MIT"

  # Runtime asset attribution/license notice.
  install -Dm644 assets/fonts/tabler-icons-license.txt \
    "$licensedir/Tabler-Icons-LICENSE"

  # Preserve upstream credits for bundled branding and media assets.
  install -Dm644 CREDITS.md \
    "$docdir/CREDITS.md"
}
